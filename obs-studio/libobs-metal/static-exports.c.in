/* Generated by libobs-metal/CMakeLists.txt (iOS port).
 *
 * Maps the export names that libobs looks up in a graphics module to the
 * functions of the statically linked Metal renderer. Pass this function to
 * gs_register_static_module("libobs-metal", libobs_metal_get_export). */

#include <stddef.h>
#include <string.h>

@LIBOBS_METAL_DECLARATIONS@
static const struct {
	const char *name;
	void (*func)(void);
} exports[] = {
@LIBOBS_METAL_EXPORTS@};

void *libobs_metal_get_export(const char *name)
{
	for (size_t i = 0; i < sizeof(exports) / sizeof(exports[0]); i++) {
		if (strcmp(exports[i].name, name) == 0)
			return (void *)exports[i].func;
	}

	return NULL;
}
